# Copy to .env (git-ignored). Never commit real keys.

# --- Storage ---------------------------------------------------------------
# postgres: PostgreSQL + pgvector from docker-compose (docker compose up -d db)
# sqlite:   local file fallback, no Docker needed (used by the tests)
STORE_BACKEND=postgres
DATABASE_URL=postgresql://faultfinder:faultfinder@localhost:5433/faultfinder
SQLITE_PATH=data/local/faultfinder.db

# --- Manual ------------------------------------------------------------------
# Folder or file. A PDF or .txt in data/manual/ is ingested. If none exists a
# SYNTHETIC stand-in manual is generated.
MANUAL_PATH=data/manual

# --- Model -------------------------------------------------------------------
# fake:   offline FakeLLM + deterministic hash embedder (default, no key needed)
# azure:  Azure OpenAI
# openai: any OpenAI-compatible endpoint (OPENAI_BASE_URL)
LLM_PROVIDER=fake

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Embedding size: 256 for the fake embedder, 1536 for text-embedding-3-small.
# Changing it requires re-running ingest and seed.
EMBED_DIM=256

# --- Retrieval / agent --------------------------------------------------------
RERANKER=overlap
MAX_TOOL_CALLS=6
TRACE_DIR=traces
SAFETY_RULES_PATH=config/safety_rules.yaml
PRICES_PATH=config/prices.yaml
